// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User{
  id Int @id @default(autoincrement())
  name String
  email String  @unique
  password String 
  role Role @default(USER)

  venues Venue[]
  bookings  Booking[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  OWNER
  ADMIN
}

model Venue{
  id Int @id @default(autoincrement())
  name String
  description String

  address String
  city String
  district String
  state String

  latitude  Decimal? @db.Decimal(10,8)
  longitude Decimal? @db.Decimal(11,8)

  capacity Int
  pricePerHour Decimal @db.Decimal(10,2)
  imageUrl String?

  ownerId Int 
  owner User @relation(fields: [ownerId], references: [id])

  bookings  Booking[]

  venueType VenueType
  amenities String[]

  approvalStatus VenueApprovalStatus @default(PENDING)

  isActive Boolean @default(true)
  isDeleted Boolean @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([approvalStatus])
  @@index([venueType])
  @@index([city])
  @@index([district])
  @@index([state])
  @@index([approvalStatus, city])
  @@index([approvalStatus, venueType])
  @@index([approvalStatus, city, venueType])
}
enum VenueType {
  AUDITORIUM
  CONFERENCE_HALL
  PARTY_HALL
  OUTDOOR_VENUE
  BANQUET_HALL
  MEETING_ROOM
  SPORTS_ARENA
  OTHER
}
enum VenueApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Booking{
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id])
  venueId Int
  venue Venue @relation(fields: [venueId], references: [id])
  startTime DateTime
  endTime DateTime
  totalAmount Decimal @db.Decimal(10, 2)
  status BookingStatus @default(PENDING)
  isOwnerBooking Boolean        @default(false)
  payment Payment?
  isDeleted       Boolean  @default(false)
  cancelledAt     DateTime?
  createdAt DateTime @default(now())
  updatedAt    DateTime @updatedAt


  @@index([userId])
  // Optimizes overlap checking queries
  @@index([venueId, startTime, endTime])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Payment {
  id                Int      @id @default(autoincrement())

  bookingId         Int      @unique
  booking           Booking  @relation(fields:[bookingId], references:[id])

  amount            Decimal  @db.Decimal(10,2)
  currency          String   @default("INR")

  status            PaymentStatus @default(PENDING)
  provider          PaymentProvider

  providerOrderId   String? @unique
  providerPaymentId String? @unique
  transactionId     String? @unique

  refundedAt        DateTime?
  refundAmount Decimal? @db.Decimal(10,2)

  failureReason String?
  refundReason  String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
  CASHFREE
}